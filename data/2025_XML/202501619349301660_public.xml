    <IRS990ScheduleO documentId="IRS990ScheduleO" softwareId="23017517" softwareVersionNum="2023v6.0">
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section A, Line 6</FormAndLineReferenceDesc>
        <ExplanationTxt>THE ORGANIZATION IS A 501(C)(9) ASSOCIATION FOR ACTIVE SWORN POLICE OFFICERS OR EMPLOYEES ENROLLED IN THE POLICE ACADEMY WHO ARE TO BECOME A REGULAR SWORN POLICE OFFICERS OF THE CITY OF SAN DIEGO.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section A, Line 7a</FormAndLineReferenceDesc>
        <ExplanationTxt>THE BOARD OF DIRECTORS IS ELECTED TO THREE YEAR TERMS BY THE ORGANIZATION'S MEMBERS.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section A, Line 7b</FormAndLineReferenceDesc>
        <ExplanationTxt>ALL DECISIONS INVOLVING ACCEPTANCE OF CONTRACTS ARE SUBJECT TO APPROVAL BY THE ORGANIZATION'S MEMBERS.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section B, Line 11b</FormAndLineReferenceDesc>
        <ExplanationTxt>ALL BOARD MEMBERS ARE PROVIDED A COPY OF THE FORM 990 FOR REVIEW AND APPROVAL PRIOR TO FILING.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section B, Line 12c</FormAndLineReferenceDesc>
        <ExplanationTxt>EACH DIRECTOR, PRINCIPAL OFFICER AND MEMBER OF A COMMITTEE WITH GOVERNING BOARD-DELEGATED POWERS SHALL SIGN A STATEMENT ANNUALLY WHICH AFFIRMS SUCH PERSON HAS RECEIVED A COPY OF THE CONFLICT OF INTEREST POLICY, HAS READ AND UNDERSTANDS THE POLICY, AGREES TO COMPLY WITH THE POLICY AND UNDERSTANDS THE SDPOA HAS A CHARITABLE MISSION AND IN ORDER TO MAINTAIN ITS FEDERAL TAX EXEMPT STATUS, IT MUST ENGAGE PRIMARILY IN ACTIVITIES THAT ACCOMPLISH ONE OR MORE OF ITS TAX-EXEMPT PURPOSES.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section B, Line 15a</FormAndLineReferenceDesc>
        <ExplanationTxt>ALL DECISIONS REGARDING COMPENSATION ARE BROUGHT BEFORE THE BOARD AND BUDGET COMMITTEE FOR APPROVAL.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section C, Line 19</FormAndLineReferenceDesc>
        <ExplanationTxt>THE ORGANIZATION IS A 501(C)(9) AND IS NOT REQUIRED TO MAKE ITS DOCUMENTS AVAILABLE FOR PUBLIC INSPECTION. THE ORGANIZATION DOES MAKE ITS GOVERNING DOCUMENTS AND FINANCIAL STATEMENTS AVAILABLE TO ITS MEMBERS.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Statement Note 1</FormAndLineReferenceDesc>
        <ExplanationTxt>SAN DIEGO COUNTY FLOOD DISASTER POSTPONEMENT UNDER IR-2024-51 AND CA 145</ExplanationTxt>
      </SupplementalInformationDetail>
    </IRS990ScheduleO>
