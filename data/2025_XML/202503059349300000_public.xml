    <IRS990ScheduleO documentId="IRS990ScheduleO" softwareId="24020490" softwareVersionNum="2024v5.2">
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section A, Line 6</FormAndLineReferenceDesc>
        <ExplanationTxt>SAN DIEGO 6 SOFTWARE INDUSTRY COUNCIL ("SDSIC") HAS TWO CLASSES OF MEMBERS, FULL MEMBERS AND ASSOCIATE MEMBERS. FULL MEMBERS OF SDSIC ARE ENTITIES ENGAGED IN BUSINESS FOR PROFIT DIRECTLY IN THE SOFTWARE INDUSTRY IN SAN DIEGO COUNTY AND PERSONS AFFILIATED WITH SUCH ENTITIES WHO MEET CERTAIN CRITERIA SET BY THE BOARD OF DIRECTORS. ASSOCIATE MEMBERS OF SDSIC ARE THOSE ENTITIES ENGAGED IN BUSINESS RELATED TO THE SOFTWARE INDUSTRY IN SAN DIEGO COUNTY AND PERSON AFFILIATED WITH SUCH ENTITIES, WHO MEET CERTAIN CRITERIA SET BY THE BOARD OF DIRECTORS.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section A, Line 7a</FormAndLineReferenceDesc>
        <ExplanationTxt>ALL FULL MEMBERS IN GOOD STANDING SHALL HAVE THE RIGHT TO VOTE ON THE ELECTION OF DIRECTORS, ON THE DISPOSITION OF ALL OR SUBSTANTIALLY ALL OF THE ASSETS OF SDSIC, ON ANY MERGER AND ITS PRINCIPAL TERMS AND ANY AMENDMENT TO THOSE TERMS AND ON ANY ELECTION TO DISSOLVE SDSIC PURSUANT TO ARTICLE 3.2.1 OF THE BYLAWS. ASSOCIATE MEMBERS DO NOT HAVE VOTING RIGHTS.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section B, Line 11b</FormAndLineReferenceDesc>
        <ExplanationTxt>SDSIC ENGAGES AN OUTSIDE TAX PREPARER TO ASSIST IN THE PREPARATION OF ITS FORM 990. THE EXECUTIVE DIRECTOR REVIEWS THE FORM 990 BEFORE FILING.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>Form 990, Part VI, Section C, Line 19</FormAndLineReferenceDesc>
        <ExplanationTxt>No documents available to the public.</ExplanationTxt>
      </SupplementalInformationDetail>
    </IRS990ScheduleO>
