    <IRS990ScheduleO documentId="RetDoc1044400001">
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>FORM 990, PART VI, SECTION A, LINE 6</FormAndLineReferenceDesc>
        <ExplanationTxt>THE REGULAR MEMBERSHIP OF THE CORPORATION SHALL BE VOTING MEMBERS. EACH REGULAR MEMBER MUST BE A PROFESSIONAL OR PROFESSIONALLY ORIENTED ARTS PRODUCER, OWNER, MANAGER, OR PRESENTER, EITHER COMMERCIAL OR NOT-FOR-PROFIT, WITHIN SAN DIEGO COUNTY. ASSOCIATE MEMBERSHIP OF THE CORPORATION SHALL NOT BE VOTING MEMBERS. EACH ASSOCIATE MEMBER MUST BE A PROFESSIONAL OR PROFESSIONALLY ORIENTED OWNER, MANAGER, OR INDIVIDUAL, EITHER COMMERCIAL OR NOT-FOR-PROFIT WITHIN SAN DIEGO COUNTY THAT PROVIDES PRODUCTS AND/OR SERVICES TO ARTS ORGANIZATIONS. AFFILIATE MEMBERSHIP OF THE CORPORATION SHALL NOT BE VOTING MEMBERS. CRITERIA AND ELIGIBILITY SHALL BE DETERMINED FIRST BY THE MEMBERSHIP COMMITTEE AND THEN THE BOARD OF DIRECTORS.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>FORM 990, PART VI, SECTION A, LINE 7A</FormAndLineReferenceDesc>
        <ExplanationTxt>DIRECTORS ARE ELECTED BY MEMBERS AT EACH ANNUAL MEETING OF THE CORPORATION FOR A TWO-YEAR TERM.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>FORM 990, PART VI, SECTION B, LINE 11B</FormAndLineReferenceDesc>
        <ExplanationTxt>THE 990 IS REVIEWED AND APPROVED BY THE BOARD PRIOR TO FILING.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>FORM 990, PART VI, SECTION B, LINE 12C</FormAndLineReferenceDesc>
        <ExplanationTxt>THE BOARD REVIEWS AND DISCUSSES ANY CONFLICT OF INTEREST WHICH MAY ARISE.</ExplanationTxt>
      </SupplementalInformationDetail>
      <SupplementalInformationDetail>
        <FormAndLineReferenceDesc>FORM 990, PART VI, SECTION B, LINE 15A</FormAndLineReferenceDesc>
        <ExplanationTxt>THE BOARD OF DIRECTORS REVIEWS THE COMPENSATION OF THE OFFICERS OF THE ORGANIZATION AND APPROVES A COMPENSATION BASED ON OTHER SIMILAR POSITIONS IN OTHER CITIES.</ExplanationTxt>
      </SupplementalInformationDetail>
